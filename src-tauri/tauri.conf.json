{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DB Sage",
  "version": "0.12.7",
  "identifier": "com.dbsage.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "DB Sage",
        "width": 500,
        "height": 290,
        "resizable": false,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "skipTaskbar": true,
        "backgroundColor": "#22252f"
      },
      {
        "label": "main",
        "title": "DB Sage",
        "width": 1440,
        "height": 880,
        "minWidth": 1080,
        "minHeight": 640,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "backgroundColor": "#22252f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "template": "installer.nsi"
      }
    }
  }
}
